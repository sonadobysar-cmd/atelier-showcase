# Nia Dobyšar portfolio (atelier-showcase) — produkční proměnné

# Google Meet — trvalý odkaz na tvoji konzultační místnost (meet.google.com → Nové setkání → zkopíruj odkaz)
NIA_GOOGLE_MEET_URL=https://meet.google.com/xxx-xxxx-xxx

# Resend — https://resend.com (potvrzovací e-maily klientům + notifikace tobě)
RESEND_API_KEY=re_...

# Odesílatel (po ověření domény v Resend, např. konzultace@niadobysar.cz)
NIA_EMAIL_FROM="Nia Dobyšar <konzultace@niadobysar.cz>"

# Kam chodí notifikace o nových rezervacích
NIA_EMAIL_TO=niadobyshar@gmail.com
