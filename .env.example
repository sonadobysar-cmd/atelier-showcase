# Nia Dobyšar portfolio (atelier-showcase) — produkční proměnné

# Google Meet — trvalý odkaz na tvoji konzultační místnost (meet.google.com → Nové setkání → zkopíruj odkaz)
NIA_GOOGLE_MEET_URL=https://meet.google.com/xxx-xxxx-xxx

# Resend — https://resend.com (potvrzovací e-maily klientům + notifikace tobě)
RESEND_API_KEY=re_...

# Odesílatel (po ověření domény v Resend, např. konzultace@niadobysar.com)
NIA_EMAIL_FROM="Nia Dobyšar <konzultace@niadobysar.com>"

# Kam chodí notifikace o nových rezervacích
NIA_EMAIL_TO=niadobysar@gmail.com

# Vercel Blob — trvalé uložení rezervací (na Vercelu se nastaví automaticky s Blob store)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Lokální vývoj — složka pro bookings.json (volitelné)
# NIA_BOOKINGS_DATA_DIR=./data/nia-konzultace

# Tajný klíč pro sync do appky Upomínky (Bearer token v hlavičce)
UPOMINKY_SYNC_SECRET=vygeneruj-nahodny-retezec-min-32-znaku

# --- Ochrana formulářů (Cloudflare Turnstile + Upstash) ---

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile → Add site (Invisible)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis — https://console.upstash.com → Create database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Podpis časové pasti formuláře (min. 16 znaků, náhodný řetězec)
NIA_FORM_TOKEN_SECRET=vygeneruj-nahodny-retezec-min-32-znaku

# Token pro zobrazení/export logů (/nia/admin/logy.html)
NIA_SECURITY_LOG_TOKEN=vygeneruj-nahodny-retezec-min-32-znaku

# Token pro správu obchodu a UGC videí (/nia/admin/obsah.html)
NIA_CMS_ADMIN_TOKEN=vygeneruj-nahodny-retezec-min-32-znaku

# Lokální vývoj — složka pro catalog.json (volitelné)
# NIA_CMS_DATA_DIR=./data/nia-cms

# Volitelné: další povolené Originy (čárkou oddělené)
# NIA_ALLOWED_ORIGINS=https://preview.vercel.app

# Veřejná URL webu (Stripe redirect, odkazy ke stažení)
NIA_SITE_URL=https://www.niadobysar.com

# --- E-shop: Stripe Checkout (https://dashboard.stripe.com) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook endpoint: https://www.niadobysar.com/api/nia/shop/webhook
# Událost: checkout.session.completed

# --- E-shop: Fakturoid (https://app.fakturoid.cz → Nastavení → API) ---
FAKTUROID_ACCOUNT_SLUG=tvuj-ucet
FAKTUROID_API_TOKEN=
FAKTUROID_USER_EMAIL=niadobysar@gmail.com
# FAKTUROID_APP_NAME=NiaDobysarShop
# FAKTUROID_VAT_RATE=21

# Lokální vývoj — objednávky e-shopu (volitelné)
# NIA_SHOP_ORDERS_DATA_DIR=./data/nia-shop
